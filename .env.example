# Server-only: the Chalai API. Every API call is made from the Next.js server.
CHALAI_API_URL=http://localhost:4000/api/v1
# Browser: the Socket.IO origin for live updates (namespace /realtime).
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
# Browser: the Chalai bot script (../chalai-bot). In development, run `npm run serve` there.
# Left unset outside development, the bot button stays hidden.
NEXT_PUBLIC_CHALAI_BOT_URL=http://localhost:5190/chalai-bot.js
