DirectoryIndex index.html
Options -MultiViews
ErrorDocument 404 /404.html

RewriteEngine On

# HTTPS only (.app domains are HTTPS-only in browsers anyway)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Add a trailing slash to page URLs (/floor -> /floor/, /orders/view?id=x -> /orders/view/?id=x)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]+$
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

# Build files have a content hash in their name: cache them for a year
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
